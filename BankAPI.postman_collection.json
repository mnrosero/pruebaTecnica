          "name": "Estado de Cuenta por Cliente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8082/api/v1/reportes/estado-cuenta?clienteId=jose.lema&fechaInicio=2022-02-01&fechaFin=2022-02-28",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api","v1","reportes","estado-cuenta"],
              "query": [
                { "key": "clienteId", "value": "jose.lema" },
                { "key": "fechaInicio", "value": "2022-02-01" },
                { "key": "fechaFin", "value": "2022-02-28" }
