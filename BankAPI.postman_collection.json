              "raw": "{\n  \"numeroCuenta\": \"478758\",\n  \"tipoCuenta\": \"Ahorro\",\n  \"saldoInicial\": 2000,\n  \"estado\": true,\n  \"clienteId\": \"jose.lema\"\n}"
            },
            "url": { "raw": "http://localhost:8082/api/v1/cuentas", "protocol": "http", "host": ["localhost"], "port": "8082", "path": ["api","v1","cuentas"] }
