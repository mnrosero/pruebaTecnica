{
  "info": {
    "name": "Bank API - Microservicios",
    "description": "Colección de endpoints para Cliente, Cuenta, Movimiento y Reportes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Crear Cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"jose.lema\",\n  \"contrasenia\": \"1234\",\n  \"estado\": true,\n  \"identificacion\": \"ID001\",\n  \"nombre\": \"Jose Lema\",\n  \"genero\": \"M\",\n  \"edad\": 34,\n  \"direccion\": \"Otavalo sn y principal\",\n  \"telefono\": \"098254785\"\n}"
            },
            "url": { "raw": "http://localhost:8081/api/v1/clientes", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["api","v1","clientes"] }
          }
        },
        {
          "name": "Listar Clientes",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8081/api/v1/clientes", "protocol": "http", "host": ["localhost"], "port": "8081", "path": ["api","v1","clientes"] }
          }
        }
      ]
    },
